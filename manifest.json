{
  "manifest_version": 3,
  "name": "Youtube Ad Tool",
  "version": "1.6",
  "description": "Place et nettoie les emplacements d'annonce mid-roll de YouTube Studio : régulier, silences, réduction auto, presets.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://studio.youtube.com/*",
    "https://raw.githubusercontent.com/*",
    "https://discord.com/*"
  ],
  "icons": {
    "16": "ico16.png",
    "32": "ico32.png",
    "48": "ico48.png",
    "128": "ico128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nettoyer les emplacements pub invalides",
    "default_icon": {
      "16": "ico16.png",
      "32": "ico32.png",
      "48": "ico48.png",
      "128": "ico128.png"
    }
  }
}
